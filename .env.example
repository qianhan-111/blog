DATABASE_URL=
JWT_SECRET=replace-with-at-least-32-characters
JWT_EXPIRES_IN_SECONDS=86400
VITE_API_BASE_URL=/api
VITE_APP_TITLE=Blog Platform
VITE_SITE_URL=http://localhost:5173
VITE_INDEXING_ENABLED=false
VITE_OBSERVABILITY_ENABLED=false
VITE_OBSERVABILITY_DSN=
# local is only for local development. On Vercel, omit this or use a commit SHA/version.
VITE_RELEASE_VERSION=local

# Optional: override demo accounts created by `npm run db:seed`.
# Leave blank to use the documented demo accounts.
SEED_ADMIN_USERNAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NICKNAME=
SEED_ADMIN_BIO=
SEED_AUTHOR_USERNAME=
SEED_AUTHOR_EMAIL=
SEED_AUTHOR_PASSWORD=
SEED_AUTHOR_NICKNAME=
SEED_AUTHOR_BIO=
