{
  "name": "blog",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "lint": "eslint . --ext .ts,.vue --max-warnings 0",
    "typecheck": "vue-tsc -b",
    "test:unit": "vitest run tests/unit",
    "test:backend": "vitest run --config vitest.backend.config.ts",
    "test:smoke": "vitest run --config vitest.smoke.config.ts",
    "test:coverage": "vitest run tests/unit --coverage",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "package:handoff": "powershell -ExecutionPolicy Bypass -File scripts/create-handoff-package.ps1",
    "build": "npm run typecheck && vite build",
    "verify": "npm run lint && npm run test:unit && npm run test:backend && npm run test:smoke && npm run build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@neondatabase/serverless": "^1.1.0",
    "@vueuse/core": "^14.3.0",
    "axios": "^1.16.0",
    "bcryptjs": "^3.0.3",
    "element-plus": "^2.14.0",
    "jose": "^6.2.3",
    "md-editor-v3": "^6.5.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.34",
    "vue-router": "^5.0.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitest/coverage-v8": "^4.1.6",
    "@vue/test-utils": "^2.4.10",
    "@vue/tsconfig": "^0.9.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.4.0",
    "eslint-plugin-vue": "^10.9.1",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "sass": "^1.99.0",
    "tsx": "^4.22.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.3",
    "vite": "^8.0.12",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.6",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.2.8"
  },
  "overrides": {
    "js-beautify": {
      "glob": "^13.0.6"
    }
  }
}
